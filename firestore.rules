rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Product catalogue is public-read and backend/admin-write only.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Customers can access only their own profile.
    match /customers/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;

      // Legacy nested orders remain read-only.
      match /orders/{orderId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Top-level orders are created/updated only by trusted Cloud Functions.
    // Customers may read only their own orders.
    match /orders/{orderId} {
      allow read: if request.auth != null
        && resource.data.customerId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Each saved address belongs to the signed-in customer.
    match /addresses/{addressId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Deny all other access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
