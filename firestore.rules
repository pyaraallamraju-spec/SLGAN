rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Product catalogue is public-read. Only users whose trusted customer
    // profile has is_admin == true may create, update, or delete products.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/customers/$(request.auth.uid))
        && get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.is_admin == true;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Disease catalogue is public-read for the customer selector.
    // Only trusted administrators may add or edit catalogue entries.
    match /diseases/{diseaseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Shared counter used by the Admin Diseases page for atomic numeric IDs.
    match /system_counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Customer profiles are private to their owner; admins can manage account status.
    // The is_admin role is managed only by trusted Firebase Admin SDK scripts.
    match /customers/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.is_admin == false
        && request.resource.data.is_active == true;

      allow update: if request.auth != null && (
        // Verified admins may change only is_active and updatedAt.
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['is_active', 'updatedAt'])
          && request.resource.data.is_active is bool)
        ||
        // Customers may update their own profile, but not their role or status.
        (request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['is_admin', 'is_active', 'enabled'])
          && (
            (!('is_admin' in resource.data)
              && request.resource.data.is_admin == false)
            || request.resource.data.is_admin == resource.data.is_admin
          ))
      );

      allow delete: if request.auth != null
        && request.auth.uid == userId;

      match /orders/{orderId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Orders are client-created on the Spark plan. Restrict each order to
    // its authenticated owner and keep it pending until the shop verifies it.
    // Client-supplied prices are not trusted for final fulfilment/payment.
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (isAdmin() || resource.data.customerId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0
        && request.resource.data.orderId.size() <= 40
        && request.resource.data.orderStatus == 'pending_verification'
        && request.resource.data.paymentStatus == 'not_collected'
        && request.resource.data.invoiceStatus == 'not_generated'
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.shippingAddress is string
        && request.resource.data.shippingAddress.size() > 0
        && request.resource.data.shippingAddress.size() <= 1000
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.grandTotal is number
        && request.resource.data.grandTotal >= 0
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['orderStatus', 'updatedAt'])
        && request.resource.data.orderStatus in ['accepted', 'rejected'];
      allow delete: if false;
    }

    // One customer rating per product. Ratings are readable so product cards can
    // display a live average, but each customer can only create/edit their own record.
    // Document ID format: <productId>_<Firebase Auth UID>.
    match /productRatings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() <= 200
        && ratingId == request.resource.data.productId + '_' + request.auth.uid
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.productName.size() <= 200
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() <= 1000;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.productName is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() <= 1000
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['productName', 'userName', 'rating', 'review', 'updatedAt']);
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // One like per signed-in customer and product.
    // Document ID format: <productId>_<Firebase Auth UID>; counts are derived from these records.
    match /productLikes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() <= 200
        && likeId == request.resource.data.productId + '_' + request.auth.uid
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.productName.size() <= 200;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Each saved address belongs to the signed-in customer.
    match /addresses/{addressId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Deny all other access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
