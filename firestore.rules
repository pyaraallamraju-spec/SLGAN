rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Product catalogue is public-read. Only users whose trusted customer
    // profile has is_admin == true may create, update, or delete products.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/customers/$(request.auth.uid))
        && get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.is_admin == true;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Disease names are public catalogue data used by the Select disease search.
    match /diseases/{diseaseId} {
      allow read: if true;
      allow write: if false;
    }

    // Customers can access only their own profile. The is_admin role is
    // managed by trusted Firebase Admin SDK scripts, never by the client.
    match /customers/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.is_admin == false;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && (
          ( !('is_admin' in resource.data)
            && request.resource.data.is_admin == false )
          || request.resource.data.is_admin == resource.data.is_admin
        );
      allow delete: if request.auth != null
        && request.auth.uid == userId;

      // Legacy nested orders remain read-only.
      match /orders/{orderId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Orders are client-created on the Spark plan. Restrict each order to
    // its authenticated owner and keep it pending until the shop verifies it.
    // Client-supplied prices are not trusted for final fulfilment/payment.
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (isAdmin() || resource.data.customerId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.orderId == orderId
        && request.resource.data.orderStatus == 'pending_verification'
        && request.resource.data.paymentStatus == 'not_collected'
        && request.resource.data.invoiceStatus == 'not_generated'
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.shippingAddress is string
        && request.resource.data.shippingAddress.size() > 0
        && request.resource.data.shippingAddress.size() <= 1000
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.grandTotal is number
        && request.resource.data.grandTotal >= 0
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['orderStatus', 'updatedAt'])
        && request.resource.data.orderStatus in ['accepted', 'rejected'];
      allow delete: if false;
    }

    // Each saved address belongs to the signed-in customer.
    match /addresses/{addressId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Deny all other access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
