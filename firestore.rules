rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Product catalogue is public-read. Only users whose trusted customer
    // profile has is_admin == true may create, update, or delete products.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/customers/$(request.auth.uid))
        && get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.is_admin == true;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Category catalogue is read by the shop and maintained from the admin product editor.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Disease catalogue is public-read for the customer selector.
    // Only trusted administrators may add or edit catalogue entries.
    match /diseases/{diseaseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Shared counter used by the Admin Diseases page for atomic numeric IDs.
    match /system_counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Customer profiles are private to their owner; admins can manage account status.
    // The is_admin role is managed only by trusted Firebase Admin SDK scripts.
    match /customers/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'is_admin', 'is_active', 'email', 'firstName', 'lastName',
          'nickname', 'gender', 'dateOfBirth', 'countryIso', 'countryFlag',
          'countryDialCode', 'mobileNumber', 'updatedAt',
          'profileCompletionRequired', 'notificationsEnabled', 'fcmTokens'
        ])
        && request.resource.data.is_admin == false
        && request.resource.data.is_active == true
        && (!('notificationsEnabled' in request.resource.data)
          || request.resource.data.notificationsEnabled is bool)
        && (!('fcmTokens' in request.resource.data)
          || request.resource.data.fcmTokens is list);

      allow update: if request.auth != null && (
        // Trusted admins may edit customer profile fields and account status,
        // but can never change the protected administrator role.
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'is_active', 'updatedAt', 'firstName', 'lastName', 'nickname',
            'email', 'mobileNumber', 'countryCode', 'countryIso', 'gender'
          ])
          && (!('is_active' in request.resource.data)
            || request.resource.data.is_active is bool))
        ||
        // Customers may edit only their own supported profile fields.
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email', 'firstName', 'lastName', 'nickname', 'gender',
            'dateOfBirth', 'countryIso', 'countryFlag', 'countryDialCode',
            'mobileNumber', 'updatedAt', 'profileCompletionRequired',
            'notificationsEnabled', 'fcmTokens'
          ])
          && (!('notificationsEnabled' in request.resource.data)
            || request.resource.data.notificationsEnabled is bool)
          && (!('fcmTokens' in request.resource.data)
            || request.resource.data.fcmTokens is list)
          && (
            (!('is_admin' in resource.data)
              && request.resource.data.is_admin == false)
            || request.resource.data.is_admin == resource.data.is_admin
          ))
      );

      allow delete: if request.auth != null
        && request.auth.uid == userId;

      match /orders/{orderId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Shared app settings (theme and home banners): customers may read
    // the active presentation settings; only trusted administrators may change them.
    match /appSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders are client-created on the Spark plan. Restrict each order to
    // its authenticated owner and keep it pending until the shop verifies it.
    // Client-supplied prices are not trusted for final fulfilment/payment.
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (isAdmin() || resource.data.customerId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'orderId', 'customerId', 'customerName', 'email', 'phone',
          'deliveryAddressId', 'deliveryAddress', 'shippingAddress',
          'deliveryAddressLabel', 'deliveryRecipientName', 'deliveryPhone',
          'deliveryInstruction', 'user_instructions', 'items', 'subtotal',
          'deliveryCharges', 'deliveryWeightGrams', 'grandTotal', 'currency',
          'paymentMethod', 'paymentEnvironment', 'paymentStatus',
          'orderStatus', 'invoiceNumber', 'invoiceStatus', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.orderId is string
        && request.resource.data.orderId == orderId
        && request.resource.data.orderId.size() > 0
        && request.resource.data.orderId.size() <= 40
        && request.resource.data.orderStatus == 'pending_verification'
        && request.resource.data.paymentStatus == 'not_collected'
        && request.resource.data.invoiceStatus == 'not_generated'
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.shippingAddress is string
        && request.resource.data.shippingAddress.size() > 0
        && request.resource.data.shippingAddress.size() <= 1000
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.grandTotal is number
        && request.resource.data.grandTotal >= 0
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['orderStatus', 'updatedAt'])
        && request.resource.data.orderStatus in ['accepted', 'rejected'];
      allow delete: if false;
    }

    // One customer rating per product. Ratings are readable so product cards can
    // display a live average, but each customer can only create/edit their own record.
    // Document ID format: <productId>_<Firebase Auth UID>.
    match /productRatings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'productId', 'productName', 'userId', 'userName',
          'rating', 'review', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() <= 200
        && ratingId == request.resource.data.productId + '_' + request.auth.uid
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.productName.size() <= 200
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() <= 1000;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.productName is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() <= 1000
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['productName', 'userName', 'rating', 'review', 'updatedAt']);
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // One like per signed-in customer and product.
    // Document ID format: <productId>_<Firebase Auth UID>; counts are derived from these records.
    match /productLikes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'productId', 'productName', 'userId', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() <= 200
        && likeId == request.resource.data.productId + '_' + request.auth.uid
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.productName.size() <= 200;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Saved addresses are private to their owner. Accept only fields written by
    // the current Android address editor; keep ownership and creation time immutable.
    match /addresses/{addressId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'userId', 'city', 'area', 'address', 'addressText', 'googleMapsLink',
          'latitude', 'longitude', 'name', 'phone', 'label',
          'isDefault', 'default', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.city is string
        && request.resource.data.area is string
        && request.resource.data.address is string
        && request.resource.data.addressText is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.label is string
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
      allow read: if request.auth != null
        && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'city', 'area', 'address', 'addressText', 'googleMapsLink',
          'latitude', 'longitude', 'name', 'phone', 'label', 'isDefault', 'default'
        ])
        && request.resource.data.city is string
        && request.resource.data.area is string
        && request.resource.data.address is string
        && request.resource.data.addressText is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.label is string
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
    }

    // Deny all other access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}